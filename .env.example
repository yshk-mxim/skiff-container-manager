# SKIFF Container Manager — configuration template
# Copy to .env and fill in your values:
#   cp .env.example .env

# ── Required ────────────────────────────────────────────────
# Bearer token for API authentication. Generate with:
#   openssl rand -hex 32
API_TOKEN=

# ── Docker connection ────────────────────────────────────────
# Local Docker Engine (default — works on Linux and Docker Desktop):
DOCKER_HOST=unix:///var/run/docker.sock

# Remote Docker over SSH tunnel — open the tunnel first:
#   ssh -fNL /tmp/docker.sock:/var/run/docker.sock user@docker-host
# Then set:
# DOCKER_HOST=unix:///tmp/docker.sock

# ── Registry allowlist ───────────────────────────────────────
# Comma-separated prefixes. Images outside these are rejected.
ALLOWED_REGISTRIES=docker.io,ghcr.io

# GCP Artifact Registry example:
# ALLOWED_REGISTRIES=us-docker.pkg.dev/my-project/

# ── Network ──────────────────────────────────────────────────
# Port to listen on (default: 8080)
# PORT=8080

# Listen address — keep 127.0.0.1 unless you know what you're doing
# BIND_HOST=127.0.0.1

# CORS — add your workstation URL if accessing from another host
# ALLOWED_ORIGINS=http://127.0.0.1:8080

# ── UI ───────────────────────────────────────────────────────
# Hostname/IP shown for container port links in the browser UI.
# Leave empty to use the browser's current hostname.
# DOCKER_VM_HOST=docker-host.example.com

# ── Storage ──────────────────────────────────────────────────
# Compose-file directory and audit log both default to a per-user state dir
# that's writable without root (no /var/log or /data needed).
#   macOS:  ~/Library/Application Support/skiff/
#   Linux:  $XDG_STATE_HOME/skiff/  (or ~/.local/state/skiff/ if XDG_STATE_HOME is unset)
# Override in production deployments:
# COMPOSE_DIR=/data/compose
# AUDIT_LOG=/var/log/skiff-audit.jsonl
